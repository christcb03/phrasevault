# Local archive of pre-refactor artifacts (not part of the build)
old/

# Rust
/target/
**/target/

# Node.js
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# PhraseVault — never commit real data
*.db
*.db-journal
*.db-wal
*.db-shm
*.pvx

# D100 — ignore by PATH, not by extension. A blanket `*.json` meant every new
# config had to be rescued by an exception, and one that nobody thought to add
# would simply never be committed — silently, which is the whole problem.
/artifacts/**/*.json
**/target/**/*.json
!pyproject.toml
!terraform.tfvars.example

# Secrets
.env
.env.*
secrets/
*.key
*.pem

# Tests
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Ansible — local inventory (copy from inventory.example.ini; never commit)
deploy/ansible/inventory.ini
deploy/ansible/inventory.local.ini

# Pipeline artifacts (fetched test logs)
deploy/ansible/artifacts/
